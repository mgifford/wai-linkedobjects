{
  "@context": "https://raw.githubusercontent.com/mgifford/w3c-linkedobjects/main/schemas/context.jsonld",
  "@id": "https://www.w3.org/TR/WCAG22/",
  "@type": "Standard",
  "identifier": "WCAG 2.2",
  "title": "Web Content Accessibility Guidelines (WCAG) 2.2",
  "version": "2.2",
  "date": "2023-10-05",
  "publisher": "W3C",
  "url": "https://www.w3.org/TR/WCAG22/",
  "description": "Web Content Accessibility Guidelines (WCAG) 2.2 covers a wide range of recommendations for making Web content more accessible.",
  
  "principles": [
    {
      "@id": "https://www.w3.org/TR/WCAG22/#perceivable",
      "@type": "Principle",
      "identifier": "1",
      "name": "Perceivable",
      "description": "Information and user interface components must be presentable to users in ways they can perceive.",
      "guidelines": [
        {
          "@id": "https://www.w3.org/TR/WCAG22/#text-alternatives",
          "@type": "Guideline",
          "identifier": "1.1",
          "name": "Text Alternatives",
          "description": "Provide text alternatives for any non-text content so that it can be changed into other forms people need, such as large print, braille, speech, symbols or simpler language.",
          "successCriteria": [
            {
              "@id": "https://www.w3.org/TR/WCAG22/#non-text-content",
              "@type": "SuccessCriterion",
              "identifier": "1.1.1",
              "name": "Non-text Content",
              "level": "A",
              "description": "All non-text content that is presented to the user has a text alternative that serves the equivalent purpose.",
              "understanding": "https://www.w3.org/WAI/WCAG22/Understanding/non-text-content.html",
              "techniques": [
                "https://www.w3.org/WAI/WCAG22/Techniques/aria/ARIA6",
                "https://www.w3.org/WAI/WCAG22/Techniques/aria/ARIA10",
                "https://www.w3.org/WAI/WCAG22/Techniques/general/G94",
                "https://www.w3.org/WAI/WCAG22/Techniques/html/H37"
              ],
              "relatedTo": [
                "https://www.w3.org/TR/wai-aria-1.2/#aria-label",
                "https://www.w3.org/TR/wai-aria-1.2/#aria-labelledby",
                "https://html.spec.whatwg.org/#the-alt-attribute"
              ]
            }
          ]
        },
        {
          "@id": "https://www.w3.org/TR/WCAG22/#time-based-media",
          "@type": "Guideline",
          "identifier": "1.2",
          "name": "Time-based Media",
          "description": "Provide alternatives for time-based media.",
          "successCriteria": [
            {
              "@id": "https://www.w3.org/TR/WCAG22/#audio-only-and-video-only-prerecorded",
              "@type": "SuccessCriterion",
              "identifier": "1.2.1",
              "name": "Audio-only and Video-only (Prerecorded)",
              "level": "A",
              "description": "For prerecorded audio-only and prerecorded video-only media, certain alternatives are provided.",
              "understanding": "https://www.w3.org/WAI/WCAG22/Understanding/audio-only-and-video-only-prerecorded.html",
              "techniques": [
                "https://www.w3.org/WAI/WCAG22/Techniques/general/G158",
                "https://www.w3.org/WAI/WCAG22/Techniques/general/G159"
              ]
            },
            {
              "@id": "https://www.w3.org/TR/WCAG22/#captions-prerecorded",
              "@type": "SuccessCriterion",
              "identifier": "1.2.2",
              "name": "Captions (Prerecorded)",
              "level": "A",
              "description": "Captions are provided for all prerecorded audio content in synchronized media.",
              "understanding": "https://www.w3.org/WAI/WCAG22/Understanding/captions-prerecorded.html",
              "techniques": [
                "https://www.w3.org/WAI/WCAG22/Techniques/general/G87",
                "https://www.w3.org/WAI/WCAG22/Techniques/html/H95"
              ],
              "relatedTo": [
                "https://html.spec.whatwg.org/#the-track-element"
              ]
            }
          ]
        },
        {
          "@id": "https://www.w3.org/TR/WCAG22/#adaptable",
          "@type": "Guideline",
          "identifier": "1.3",
          "name": "Adaptable",
          "description": "Create content that can be presented in different ways without losing information or structure.",
          "successCriteria": [
            {
              "@id": "https://www.w3.org/TR/WCAG22/#info-and-relationships",
              "@type": "SuccessCriterion",
              "identifier": "1.3.1",
              "name": "Info and Relationships",
              "level": "A",
              "description": "Information, structure, and relationships conveyed through presentation can be programmatically determined or are available in text.",
              "understanding": "https://www.w3.org/WAI/WCAG22/Understanding/info-and-relationships.html",
              "techniques": [
                "https://www.w3.org/WAI/WCAG22/Techniques/aria/ARIA11",
                "https://www.w3.org/WAI/WCAG22/Techniques/aria/ARIA12",
                "https://www.w3.org/WAI/WCAG22/Techniques/aria/ARIA13",
                "https://www.w3.org/WAI/WCAG22/Techniques/html/H42",
                "https://www.w3.org/WAI/WCAG22/Techniques/html/H43",
                "https://www.w3.org/WAI/WCAG22/Techniques/html/H44"
              ],
              "relatedTo": [
                "https://www.w3.org/TR/wai-aria-1.2/#role",
                "https://html.spec.whatwg.org/#semantics"
              ]
            },
            {
              "@id": "https://www.w3.org/TR/WCAG22/#meaningful-sequence",
              "@type": "SuccessCriterion",
              "identifier": "1.3.2",
              "name": "Meaningful Sequence",
              "level": "A",
              "description": "When the sequence in which content is presented affects its meaning, a correct reading sequence can be programmatically determined.",
              "understanding": "https://www.w3.org/WAI/WCAG22/Understanding/meaningful-sequence.html",
              "techniques": [
                "https://www.w3.org/WAI/WCAG22/Techniques/general/G57",
                "https://www.w3.org/WAI/WCAG22/Techniques/css/C27"
              ],
              "relatedTo": [
                "https://html.spec.whatwg.org/#the-tabindex-attribute"
              ]
            }
          ]
        },
        {
          "@id": "https://www.w3.org/TR/WCAG22/#distinguishable",
          "@type": "Guideline",
          "identifier": "1.4",
          "name": "Distinguishable",
          "description": "Make it easier for users to see and hear content including separating foreground from background.",
          "successCriteria": [
            {
              "@id": "https://www.w3.org/TR/WCAG22/#use-of-color",
              "@type": "SuccessCriterion",
              "identifier": "1.4.1",
              "name": "Use of Color",
              "level": "A",
              "description": "Color is not used as the only visual means of conveying information, indicating an action, prompting a response, or distinguishing a visual element.",
              "understanding": "https://www.w3.org/WAI/WCAG22/Understanding/use-of-color.html",
              "techniques": [
                "https://www.w3.org/WAI/WCAG22/Techniques/general/G14",
                "https://www.w3.org/WAI/WCAG22/Techniques/general/G182"
              ]
            },
            {
              "@id": "https://www.w3.org/TR/WCAG22/#contrast-minimum",
              "@type": "SuccessCriterion",
              "identifier": "1.4.3",
              "name": "Contrast (Minimum)",
              "level": "AA",
              "description": "The visual presentation of text and images of text has a contrast ratio of at least 4.5:1.",
              "understanding": "https://www.w3.org/WAI/WCAG22/Understanding/contrast-minimum.html",
              "techniques": [
                "https://www.w3.org/WAI/WCAG22/Techniques/general/G18",
                "https://www.w3.org/WAI/WCAG22/Techniques/general/G148"
              ],
              "relatedTo": [
                "https://www.w3.org/Style/CSS/specs#css-color"
              ]
            }
          ]
        }
      ]
    },
    {
      "@id": "https://www.w3.org/TR/WCAG22/#operable",
      "@type": "Principle",
      "identifier": "2",
      "name": "Operable",
      "description": "User interface components and navigation must be operable.",
      "guidelines": [
        {
          "@id": "https://www.w3.org/TR/WCAG22/#keyboard-accessible",
          "@type": "Guideline",
          "identifier": "2.1",
          "name": "Keyboard Accessible",
          "description": "Make all functionality available from a keyboard.",
          "successCriteria": [
            {
              "@id": "https://www.w3.org/TR/WCAG22/#keyboard",
              "@type": "SuccessCriterion",
              "identifier": "2.1.1",
              "name": "Keyboard",
              "level": "A",
              "description": "All functionality of the content is operable through a keyboard interface.",
              "understanding": "https://www.w3.org/WAI/WCAG22/Understanding/keyboard.html",
              "techniques": [
                "https://www.w3.org/WAI/WCAG22/Techniques/general/G202",
                "https://www.w3.org/WAI/WCAG22/Techniques/html/H91"
              ],
              "relatedTo": [
                "https://html.spec.whatwg.org/#the-tabindex-attribute",
                "https://www.w3.org/TR/wai-aria-1.2/#keyboard"
              ]
            },
            {
              "@id": "https://www.w3.org/TR/WCAG22/#no-keyboard-trap",
              "@type": "SuccessCriterion",
              "identifier": "2.1.2",
              "name": "No Keyboard Trap",
              "level": "A",
              "description": "If keyboard focus can be moved to a component, focus can be moved away from that component using only a keyboard interface.",
              "understanding": "https://www.w3.org/WAI/WCAG22/Understanding/no-keyboard-trap.html",
              "techniques": [
                "https://www.w3.org/WAI/WCAG22/Techniques/general/G21"
              ]
            },
            {
              "@id": "https://www.w3.org/TR/WCAG22/#focus-not-obscured-minimum",
              "@type": "SuccessCriterion",
              "identifier": "2.4.11",
              "name": "Focus Not Obscured (Minimum)",
              "level": "AA",
              "description": "When a user interface component receives keyboard focus, the component is not entirely hidden due to author-created content.",
              "understanding": "https://www.w3.org/WAI/WCAG22/Understanding/focus-not-obscured-minimum.html",
              "techniques": [
                "https://www.w3.org/WAI/WCAG22/Techniques/css/C43"
              ],
              "note": "New in WCAG 2.2"
            }
          ]
        },
        {
          "@id": "https://www.w3.org/TR/WCAG22/#enough-time",
          "@type": "Guideline",
          "identifier": "2.2",
          "name": "Enough Time",
          "description": "Provide users enough time to read and use content.",
          "successCriteria": [
            {
              "@id": "https://www.w3.org/TR/WCAG22/#timing-adjustable",
              "@type": "SuccessCriterion",
              "identifier": "2.2.1",
              "name": "Timing Adjustable",
              "level": "A",
              "description": "For each time limit that is set by the content, conditions for turning off, adjusting, or extending are met.",
              "understanding": "https://www.w3.org/WAI/WCAG22/Understanding/timing-adjustable.html",
              "techniques": [
                "https://www.w3.org/WAI/WCAG22/Techniques/general/G133",
                "https://www.w3.org/WAI/WCAG22/Techniques/general/G180"
              ]
            }
          ]
        },
        {
          "@id": "https://www.w3.org/TR/WCAG22/#navigable",
          "@type": "Guideline",
          "identifier": "2.4",
          "name": "Navigable",
          "description": "Provide ways to help users navigate, find content, and determine where they are.",
          "successCriteria": [
            {
              "@id": "https://www.w3.org/TR/WCAG22/#bypass-blocks",
              "@type": "SuccessCriterion",
              "identifier": "2.4.1",
              "name": "Bypass Blocks",
              "level": "A",
              "description": "A mechanism is available to bypass blocks of content that are repeated on multiple Web pages.",
              "understanding": "https://www.w3.org/WAI/WCAG22/Understanding/bypass-blocks.html",
              "techniques": [
                "https://www.w3.org/WAI/WCAG22/Techniques/aria/ARIA11",
                "https://www.w3.org/WAI/WCAG22/Techniques/html/H69"
              ],
              "relatedTo": [
                "https://www.w3.org/TR/wai-aria-1.2/#landmark",
                "https://html.spec.whatwg.org/#the-nav-element"
              ]
            },
            {
              "@id": "https://www.w3.org/TR/WCAG22/#page-titled",
              "@type": "SuccessCriterion",
              "identifier": "2.4.2",
              "name": "Page Titled",
              "level": "A",
              "description": "Web pages have titles that describe topic or purpose.",
              "understanding": "https://www.w3.org/WAI/WCAG22/Understanding/page-titled.html",
              "techniques": [
                "https://www.w3.org/WAI/WCAG22/Techniques/general/G88",
                "https://www.w3.org/WAI/WCAG22/Techniques/html/H25"
              ],
              "relatedTo": [
                "https://html.spec.whatwg.org/#the-title-element"
              ]
            },
            {
              "@id": "https://www.w3.org/TR/WCAG22/#focus-visible",
              "@type": "SuccessCriterion",
              "identifier": "2.4.7",
              "name": "Focus Visible",
              "level": "AA",
              "description": "Any keyboard operable user interface has a mode of operation where the keyboard focus indicator is visible.",
              "understanding": "https://www.w3.org/WAI/WCAG22/Understanding/focus-visible.html",
              "techniques": [
                "https://www.w3.org/WAI/WCAG22/Techniques/general/G149",
                "https://www.w3.org/WAI/WCAG22/Techniques/css/C15"
              ],
              "relatedTo": [
                "https://www.w3.org/Style/CSS/specs#css-ui"
              ]
            }
          ]
        },
        {
          "@id": "https://www.w3.org/TR/WCAG22/#input-modalities",
          "@type": "Guideline",
          "identifier": "2.5",
          "name": "Input Modalities",
          "description": "Make it easier for users to operate functionality through various inputs beyond keyboard.",
          "successCriteria": [
            {
              "@id": "https://www.w3.org/TR/WCAG22/#pointer-gestures",
              "@type": "SuccessCriterion",
              "identifier": "2.5.1",
              "name": "Pointer Gestures",
              "level": "A",
              "description": "All functionality that uses multipoint or path-based gestures for operation can be operated with a single pointer.",
              "understanding": "https://www.w3.org/WAI/WCAG22/Understanding/pointer-gestures.html",
              "techniques": [
                "https://www.w3.org/WAI/WCAG22/Techniques/general/G215",
                "https://www.w3.org/WAI/WCAG22/Techniques/general/G216"
              ]
            },
            {
              "@id": "https://www.w3.org/TR/WCAG22/#target-size-minimum",
              "@type": "SuccessCriterion",
              "identifier": "2.5.8",
              "name": "Target Size (Minimum)",
              "level": "AA",
              "description": "The size of the target for pointer inputs is at least 24 by 24 CSS pixels.",
              "understanding": "https://www.w3.org/WAI/WCAG22/Understanding/target-size-minimum.html",
              "techniques": [],
              "note": "New in WCAG 2.2"
            }
          ]
        }
      ]
    },
    {
      "@id": "https://www.w3.org/TR/WCAG22/#understandable",
      "@type": "Principle",
      "identifier": "3",
      "name": "Understandable",
      "description": "Information and the operation of user interface must be understandable.",
      "guidelines": [
        {
          "@id": "https://www.w3.org/TR/WCAG22/#readable",
          "@type": "Guideline",
          "identifier": "3.1",
          "name": "Readable",
          "description": "Make text content readable and understandable.",
          "successCriteria": [
            {
              "@id": "https://www.w3.org/TR/WCAG22/#language-of-page",
              "@type": "SuccessCriterion",
              "identifier": "3.1.1",
              "name": "Language of Page",
              "level": "A",
              "description": "The default human language of each Web page can be programmatically determined.",
              "understanding": "https://www.w3.org/WAI/WCAG22/Understanding/language-of-page.html",
              "techniques": [
                "https://www.w3.org/WAI/WCAG22/Techniques/html/H57"
              ],
              "relatedTo": [
                "https://html.spec.whatwg.org/#the-lang-and-xml:lang-attributes"
              ]
            }
          ]
        },
        {
          "@id": "https://www.w3.org/TR/WCAG22/#predictable",
          "@type": "Guideline",
          "identifier": "3.2",
          "name": "Predictable",
          "description": "Make Web pages appear and operate in predictable ways.",
          "successCriteria": [
            {
              "@id": "https://www.w3.org/TR/WCAG22/#on-focus",
              "@type": "SuccessCriterion",
              "identifier": "3.2.1",
              "name": "On Focus",
              "level": "A",
              "description": "When any user interface component receives focus, it does not initiate a change of context.",
              "understanding": "https://www.w3.org/WAI/WCAG22/Understanding/on-focus.html",
              "techniques": [
                "https://www.w3.org/WAI/WCAG22/Techniques/general/G107"
              ]
            },
            {
              "@id": "https://www.w3.org/TR/WCAG22/#consistent-help",
              "@type": "SuccessCriterion",
              "identifier": "3.2.6",
              "name": "Consistent Help",
              "level": "A",
              "description": "If a Web page contains help mechanisms, they are in a consistent order relative to other Web pages.",
              "understanding": "https://www.w3.org/WAI/WCAG22/Understanding/consistent-help.html",
              "techniques": [
                "https://www.w3.org/WAI/WCAG22/Techniques/general/G220"
              ],
              "note": "New in WCAG 2.2"
            }
          ]
        },
        {
          "@id": "https://www.w3.org/TR/WCAG22/#input-assistance",
          "@type": "Guideline",
          "identifier": "3.3",
          "name": "Input Assistance",
          "description": "Help users avoid and correct mistakes.",
          "successCriteria": [
            {
              "@id": "https://www.w3.org/TR/WCAG22/#error-identification",
              "@type": "SuccessCriterion",
              "identifier": "3.3.1",
              "name": "Error Identification",
              "level": "A",
              "description": "If an input error is automatically detected, the item that is in error is identified and the error is described to the user in text.",
              "understanding": "https://www.w3.org/WAI/WCAG22/Understanding/error-identification.html",
              "techniques": [
                "https://www.w3.org/WAI/WCAG22/Techniques/aria/ARIA18",
                "https://www.w3.org/WAI/WCAG22/Techniques/aria/ARIA19",
                "https://www.w3.org/WAI/WCAG22/Techniques/general/G83"
              ],
              "relatedTo": [
                "https://www.w3.org/TR/wai-aria-1.2/#aria-invalid",
                "https://www.w3.org/TR/wai-aria-1.2/#aria-errormessage"
              ]
            },
            {
              "@id": "https://www.w3.org/TR/WCAG22/#labels-or-instructions",
              "@type": "SuccessCriterion",
              "identifier": "3.3.2",
              "name": "Labels or Instructions",
              "level": "A",
              "description": "Labels or instructions are provided when content requires user input.",
              "understanding": "https://www.w3.org/WAI/WCAG22/Understanding/labels-or-instructions.html",
              "techniques": [
                "https://www.w3.org/WAI/WCAG22/Techniques/general/G131",
                "https://www.w3.org/WAI/WCAG22/Techniques/html/H44"
              ],
              "relatedTo": [
                "https://html.spec.whatwg.org/#the-label-element"
              ]
            },
            {
              "@id": "https://www.w3.org/TR/WCAG22/#redundant-entry",
              "@type": "SuccessCriterion",
              "identifier": "3.3.7",
              "name": "Redundant Entry",
              "level": "A",
              "description": "Information previously entered by or provided to the user is either auto-populated or available for selection.",
              "understanding": "https://www.w3.org/WAI/WCAG22/Understanding/redundant-entry.html",
              "techniques": [
                "https://www.w3.org/WAI/WCAG22/Techniques/general/G221"
              ],
              "note": "New in WCAG 2.2",
              "relatedTo": [
                "https://html.spec.whatwg.org/#autofill"
              ]
            }
          ]
        }
      ]
    },
    {
      "@id": "https://www.w3.org/TR/WCAG22/#robust",
      "@type": "Principle",
      "identifier": "4",
      "name": "Robust",
      "description": "Content must be robust enough that it can be interpreted by a wide variety of user agents, including assistive technologies.",
      "guidelines": [
        {
          "@id": "https://www.w3.org/TR/WCAG22/#compatible",
          "@type": "Guideline",
          "identifier": "4.1",
          "name": "Compatible",
          "description": "Maximize compatibility with current and future user agents, including assistive technologies.",
          "successCriteria": [
            {
              "@id": "https://www.w3.org/TR/WCAG22/#name-role-value",
              "@type": "SuccessCriterion",
              "identifier": "4.1.2",
              "name": "Name, Role, Value",
              "level": "A",
              "description": "For all user interface components, the name and role can be programmatically determined.",
              "understanding": "https://www.w3.org/WAI/WCAG22/Understanding/name-role-value.html",
              "techniques": [
                "https://www.w3.org/WAI/WCAG22/Techniques/aria/ARIA14",
                "https://www.w3.org/WAI/WCAG22/Techniques/aria/ARIA16",
                "https://www.w3.org/WAI/WCAG22/Techniques/general/G108"
              ],
              "relatedTo": [
                "https://www.w3.org/TR/wai-aria-1.2/#namecalculation",
                "https://www.w3.org/TR/wai-aria-1.2/#role"
              ]
            }
          ]
        }
      ]
    }
  ],
  
  "metadata": {
    "extractedDate": "2024-02-24",
    "totalSuccessCriteria": 78,
    "newInVersion": [
      "2.4.11",
      "2.5.8",
      "3.2.6",
      "3.3.7",
      "3.3.8",
      "3.3.9"
    ],
    "conformanceLevels": {
      "A": "Minimum level",
      "AA": "Recommended level for most content",
      "AAA": "Enhanced level"
    }
  }
}
