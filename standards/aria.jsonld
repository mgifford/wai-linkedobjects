  "properties": [
    {
      "@id": "https://www.w3.org/TR/wai-aria-1.2/#aria-label",
      "@type": "Property",
      "name": "aria-label",
      "description": "Defines a string value that labels the current element.",
      "valueType": "string",
      "relatedTo": [
        "https://www.w3.org/TR/WCAG22/#non-text-content",
        "https://www.w3.org/TR/WCAG22/#name-role-value"
      ]
    },
    {
      "@id": "https://www.w3.org/TR/wai-aria-1.2/#aria-labelledby",
      "@type": "Property",
      "name": "aria-labelledby",
      "description": "Identifies the element (or elements) that labels the current element.",
      "valueType": "id-reference",
      "relatedTo": [
        "https://www.w3.org/TR/WCAG22/#non-text-content",
        "https://www.w3.org/TR/WCAG22/#name-role-value"
      ]
    },
    {
      "@id": "https://www.w3.org/TR/wai-aria-1.2/#aria-describedby",
      "@type": "Property",
      "name": "aria-describedby",
      "description": "Identifies the element (or elements) that describes the object.",
      "valueType": "id-reference",
      "relatedTo": [
        "https://www.w3.org/TR/WCAG22/#info-and-relationships"
      ]
    },
    {
      "@id": "https://www.w3.org/TR/wai-aria-1.2/#aria-hidden",
      "@type": "State",
      "name": "aria-hidden",
      "description": "Indicates whether the element is exposed to an accessibility API.",
      "valueType": "boolean",
      "relatedTo": [
        "https://www.w3.org/TR/WCAG22/#name-role-value"
      ]
    },
    {
      "@id": "https://www.w3.org/TR/wai-aria-1.2/#aria-expanded",
      "@type": "State",
      "name": "aria-expanded",
      "description": "Indicates whether a grouping element owned or controlled by this element is expanded or collapsed.",
      "valueType": "boolean",
      "relatedTo": [
        "https://www.w3.org/TR/WCAG22/#name-role-value"
      ]
    },
    {
      "@id": "https://www.w3.org/TR/wai-aria-1.2/#aria-pressed",
      "@type": "State",
      "name": "aria-pressed",
      "description": "Indicates the current pressed state of toggle buttons.",
      "valueType": "tristate",
      "relatedTo": [
        "https://www.w3.org/TR/WCAG22/#name-role-value"
      ]
    },
    {
      "@id": "https://www.w3.org/TR/wai-aria-1.2/#aria-selected",
      "@type": "State",
      "name": "aria-selected",
      "description": "Indicates the current selected state of various widgets.",
      "valueType": "boolean",
      "relatedTo": [
        "https://www.w3.org/TR/WCAG22/#name-role-value"
      ]
    },
    {
      "@id": "https://www.w3.org/TR/wai-aria-1.2/#aria-checked",
      "@type": "State",
      "name": "aria-checked",
      "description": "Indicates the current checked state of checkboxes, radio buttons, and other widgets.",
      "valueType": "tristate",
      "relatedTo": [
        "https://www.w3.org/TR/WCAG22/#name-role-value"
      ]
    },
    {
      "@id": "https://www.w3.org/TR/wai-aria-1.2/#aria-invalid",
      "@type": "State",
      "name": "aria-invalid",
      "description": "Indicates the entered value does not conform to the format expected by the application.",
      "valueType": "token",
      "relatedTo": [
        "https://www.w3.org/TR/WCAG22/#error-identification"
      ]
    },
    {
      "@id": "https://www.w3.org/TR/wai-aria-1.2/#aria-errormessage",
      "@type": "Property",
      "name": "aria-errormessage",
      "description": "Identifies the element that provides an error message for an object.",
      "valueType": "id-reference",
      "relatedTo": [
        "https://www.w3.org/TR/WCAG22/#error-identification",
        "https://www.w3.org/TR/wai-aria-1.2/#aria-invalid"
      ]
    },
    {
      "@id": "https://www.w3.org/TR/wai-aria-1.2/#aria-required",
      "@type": "Property",
      "name": "aria-required",
      "description": "Indicates that user input is required on the element before a form may be submitted.",
      "valueType": "boolean",
      "relatedTo": [
        "https://www.w3.org/TR/WCAG22/#labels-or-instructions",
        "https://html.spec.whatwg.org/#the-required-attribute"
      ]
    },
    {
      "@id": "https://www.w3.org/TR/wai-aria-1.2/#aria-live",
      "@type": "Property",
      "name": "aria-live",
      "description": "Indicates that an element will be updated, and describes the types of updates the user agents, assistive technologies, and user can expect.",
      "valueType": "token",
      "allowedValues": ["off", "polite", "assertive"]
    },
    {
      "@id": "https://www.w3.org/TR/wai-aria-1.2/#aria-atomic",
      "@type": "Property",
      "name": "aria-atomic",
      "description": "Indicates whether assistive technologies will present all, or only parts of, the changed region.",
      "valueType": "boolean"
    },
    {
      "@id": "https://www.w3.org/TR/wai-aria-1.2/#aria-modal",
      "@type": "Property",
      "name": "aria-modal",
      "description": "Indicates whether an element is modal when displayed.",
      "valueType": "boolean"
    },
    {
      "@id": "https://www.w3.org/TR/wai-aria-1.2/#aria-current",
      "@type": "Property",
      "name": "aria-current",
      "description": "Indicates the element that represents the current item within a container or set of related elements.",
      "valueType": "token",
      "allowedValues": ["page", "step", "location", "date", "time", "true", "false"]
    }
  ],
  
  "metadata": {
    "extractedDate": "2024-02-24",
    "totalRoles": 18,
    "totalProperties": 15,
    "categories": ["widget", "landmark", "live-region", "document-structure"]
  }
